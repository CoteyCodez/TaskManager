@using TaskManager.Models.ViewModels
@using TaskManager.Utilities
@model TaskItemVM

<form method="POST" enctype="multipart/form-data" asp-action="Create">
    @Html.AntiForgeryToken()
    <label asp-for="Title">Title</label>
    <input asp-for="Title" />

    <label asp-for="Description">Description</label>
    <input asp-for="Description" />

    @if (User.IsInRole(SD.RoleLeader))
        {
            <div class="mb-3">
                <label asp-for="OrganizationMemberId" class="form-label">Who do you want to assign the task to? </label>
                <select asp-for="OrganizationMemberId" asp-items="Model.OrganizationMemberList" class="form-select">
                    <option value="">-- Select User --</option>
                </select>
                <span asp-validation-for="OrganizationMemberId" class="text-danger"></span>
            </div>
        }
    <input type="file" name="file" class="form-control form-control-sm mt-2" />
    <button type="submit">Submit</button>

</form>