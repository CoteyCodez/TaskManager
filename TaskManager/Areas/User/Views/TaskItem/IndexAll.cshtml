@model List<TaskItem>

<div class="card-body" style="min-height: 500px;">
    <table id="userTblData" class="table" style="width:100%">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Assigned To</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Functions</th>
        </tr>
    </thead>

</table>
</div>

<a asp-area="User" asp-controller="TaskItem" asp-action="CreateTask" class="button">
    Create New Task
</a>

@section Scripts {
    <script src="~/js/organizationTasks.js" asp-append-version="true"></script>
}