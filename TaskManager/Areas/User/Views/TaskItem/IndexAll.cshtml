@model List<TaskItem>

<h1>Internal Tasks</h1>

<div class="card-body" style="min-height: 500px;">
    <table id="userTblData" class="table" style="width:100%">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>

        </tr>
    </thead>

</table>
</div>

@section Scripts {
    <script src="~/js/organizationTasks.js" asp-append-version="true"></script>
}