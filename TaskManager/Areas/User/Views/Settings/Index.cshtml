@using TaskManager.Models
@model ApplicationUser 

@if (Model.OrganizationId.HasValue)
{
    <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="User" asp-controller="Settings" asp-action="Leave" title="Manage">Settings</a>
            </li>
    </ul>
}

@if (!Model.OrganizationId.HasValue)
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="User" asp-controller="Settings" asp-action="JoinOrCreate" title="Manage">Settings</a>
        </li>
    </ul>
}

